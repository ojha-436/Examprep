{
  "hosting": [
    {
      "target": "examprep-ai-app",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "examprep-ai",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "target": "examprep-ai-engine",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "examprep-ai",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "target": "examprep-ai-cbt",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "examprep-ai",
            "region": "asia-south1"
          }
        }
      ]
    }
  ]
}
